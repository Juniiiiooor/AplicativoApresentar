# Copie para .env ou defina no terminal antes de rodar.
# Token exigido no cabeçalho X-Admin-Token do POST /api/perguntas.
QUIZ_ADMIN_TOKEN=

# Origens liberadas para o front-end (separadas por vírgula).
QUIZ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pasta alternativa para perguntas.json e ranking.json.
# QUIZ_DATA_DIR=

# Porta e host do servidor Flask.
PORT=8000
HOST=127.0.0.1
